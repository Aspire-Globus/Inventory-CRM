PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_system
CLIENT_ORIGIN=http://localhost:5173

# Login / security
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=7d
# Default admin created automatically on first start (when no users exist)
ADMIN_EMAIL=admin@aspire.com
ADMIN_PASSWORD=Admin@123

# Employees & departments from the CRM (leave empty to manage them in this app)
CRM_BASE_URL=https://crm.aspireglobus.com
SERVICE_API_KEY=
CRM_SYNC_MINUTES=10
